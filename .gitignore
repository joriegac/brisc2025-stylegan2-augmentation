# PyTorch extensions (compiled C++ ops — regenerated at runtime)
torch_extensions/

# Temp / scratch
_svg_render/
_tmp_*
.codex_*

# Codex smoke test history
.codex_smoke_history/

# GAN training data ZIPs — tracked as canonical inputs
# (numbered duplicates and non-128px sizes are excluded during cleanup)
data/*[0-9].zip
data/*_256.zip
data/*_512.zip

# Raw dataset — download from BRISC 2025 source
brisc2025/

# GAN training output — 130 GB of checkpoints; download separately
stylegan3_results/

# Large derived artefacts in outputs_v2 — recomputable from pipeline
outputs_v2/features/
outputs_v2/vlm_realism_audits/
outputs_v2/openai_batch/

# Intermediate SVG-to-PDF build artefacts (regenerated by Inkscape during compile)
arXiv/svg-inkscape/*-raw.pdf

# Large mosaic figures — regenerate locally with make_plausibility_panels_v2.py
# (8K rasters exceed GitHub's 50 MB warning; small versions are bundled in the arXiv tarball)
figures/brisc_raw_vs_preprocessed_mosaic.png
figures/brisc_synthetic_mosaic.png
figures/brisc_raw_vs_preprocessed_mosaic.pdf
figures/brisc_synthetic_mosaic.pdf
figures/svg_embedded/brisc_synthetic_mosaic.svg
figures/svg_embedded/brisc_raw_vs_preprocessed_mosaic.svg

# Compiled paper PDF — recompile from arXiv/noriega2026.tex or read on arXiv
arXiv/noriega2026.pdf

# Build artefacts of the arXiv submission pipeline
# (arxiv_submission/ is now tracked as the authoritative arXiv-ready source)
noriega2026_arxiv.tar.gz
